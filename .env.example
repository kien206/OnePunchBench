# Copy to .env (git-ignored) and fill in. Loaded automatically on `import onepunch`;
# variables already exported in your shell take precedence.

# Hugging Face: token for gated repos (meta-llama, google/gemma, ...): https://huggingface.co/settings/tokens
HF_TOKEN=
# Model/tokenizer cache. Keep it on the data volume (the root disk is small).
HF_HOME=
# Set to 1 once all weights are cached (avoids Hub rate limits during long runs).
HF_HUB_OFFLINE=0

# Weights & Biases (optional; or run with logger.mode=offline)
WANDB_API_KEY=
# WANDB_ENTITY=

# lm-eval lives in a separate env (stage 2: our own ground truth)
ONEPUNCH_LMEVAL_BIN=
